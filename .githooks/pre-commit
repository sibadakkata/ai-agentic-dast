#!/bin/sh
# Encoding gate — install: scripts/install_git_hooks.ps1 or scripts/install_git_hooks.sh
set -e
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
STAGED="$(git diff --cached --name-only --diff-filter=ACM || true)"
if [ -z "$STAGED" ]; then
  exit 0
fi
python3 "$ROOT/scripts/checks/check_no_null_bytes.py" $STAGED
