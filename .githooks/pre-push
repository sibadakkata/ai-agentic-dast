#!/bin/sh
set -e
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
RANGE="@{push}"
if ! git rev-parse "$RANGE" >/dev/null 2>&1; then
  RANGE="HEAD~1..HEAD"
fi
CHANGED="$(git diff --name-only "$RANGE" 2>/dev/null || true)"
if [ -z "$CHANGED" ]; then
  exit 0
fi
python3 "$ROOT/scripts/checks/check_no_null_bytes.py" $CHANGED
