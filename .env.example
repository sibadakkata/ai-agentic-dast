# =============================================================
# DAST Scanner – Local VM Environment
# Copy to .env and fill in your values. NEVER commit .env.
# =============================================================

# ── Host port (default 80) ───────────────────────────────────
SCANNER_PORT=80

# ── Target ────────────────────────────────────────────────────
T1_URL=https://your-target.example.com
T1_USERNAME=your-username@example.com
T1_PASSWORD=your-password
# T1_TOTP_SECRET=
# T1_SSO_PROVIDER=
# T1_API_KEY=
# T1_BEARER=

# ── LLM Provider (pick ONE section) ──────────────────────────

# Option A: AWS Bedrock Direct (recommended)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Option B: LiteLLM Proxy
# LITELLM_BASE_URL=https://litellm.your-company.com/
# LITELLM_API_KEY=sk-xxxx

# Option C: Direct vendor API keys
# ANTHROPIC_API_KEY=sk-ant-xxxx
# OPENAI_API_KEY=sk-xxxx

# ── Retry tuning (optional) ──────────────────────────────────
# LLM_RETRY_DELAYS=2,4,8,16,32
