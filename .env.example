# --- AI Provider Keys (at least one required) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- AWS Bedrock (optional, for Claude via Bedrock) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# --- Bedrock / boto3 retry tuning ---
# These tell the boto3 layer (used by LiteLLM under the hood) to retry
# Bedrock 503 / ThrottlingException / RequestTimeout errors transparently
# below the LLMRouter retry layer. ``adaptive`` mode adds a token-bucket
# rate limiter and jittered exponential back-off, which dramatically
# reduces the rate of regional capacity blips bubbling up as failed
# scan phases. See docs/scanner-internals.md.
AWS_RETRY_MODE=adaptive
AWS_MAX_ATTEMPTS=10

# --- LLMRouter retry budget (optional override) ---
# Comma-separated integer back-off delays (seconds) between retry
# attempts. Total attempts = len(LLM_RETRY_DELAYS) + 1.  Default if
# unset: ``2,4,8,16,32`` (5 retries, 62 s total back-off).
# Tune longer for shaky regions, e.g. ``2,4,8,16,32,60``.
# LLM_RETRY_DELAYS=2,4,8,16,32

# --- Web UI authentication ---
DAST_AUTH_USER=dast-admin
DAST_AUTH_PASS=changeme

# --- Port overrides (optional) ---
# DAST_PORT=8080
