# =============================================================
# DAST Scanner – Local VM Environment
# Copy to .env and fill in your values. NEVER commit .env.
# =============================================================

# ── Host port (default 80) ───────────────────────────────────
SCANNER_PORT=80

# ── Target ────────────────────────────────────────────────────
T1_URL=https://your-target.example.com
T1_USERNAME=your-username@example.com
T1_PASSWORD=your-password
# T1_TOTP_SECRET=
# T1_SSO_PROVIDER=
# T1_API_KEY=
# T1_BEARER=

# ── LLM Provider (pick ONE section) ──────────────────────────

# Option A: AWS Bedrock Direct (recommended)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Option B: LiteLLM Proxy
# LITELLM_BASE_URL=https://litellm.your-company.com/
# LITELLM_API_KEY=sk-xxxx

# Option C: Direct vendor API keys
# ANTHROPIC_API_KEY=sk-ant-xxxx
# OPENAI_API_KEY=sk-xxxx

# ── Retry tuning (optional) ──────────────────────────────────
# LLM_RETRY_DELAYS=2,4,8,16,32

# ── PostgreSQL dual-write (Gate 5+; EC2 uses Secrets Manager in .env) ──
# DUAL_WRITE_PG=0
# DATABASE_URL=postgresql://dast_admin:CHANGE_ME@your-rds-host:5432/dast_scanner?sslmode=require
# RDS_PASSWORD=CHANGE_ME

# ── Session cookies (production EC2 — set in host .env, never commit) ──
# DAST_SESSION_SECRET=
# DAST_COOKIE_SECURE=true

# ── SSO / SAML (production operators — see docs/SSO.md) ──
# SSO_ENABLED=false
# SAML_IDP_METADATA_URL=
# SAML_SP_ENTITY_ID=
# SAML_SP_ACS_URL=
# SAML_SP_CERT_PATH=
# SAML_SP_KEY_PATH=
# SAML_IDP_ENTITY_ID=
# SAML_IDP_SSO_URL=
# SAML_IDP_CERT=
# SAML_DEBUG=false
# SSO_USER_GROUP_IDS=
# SSO_ADMIN_GROUP_IDS=          # ignored — admin via invite / UI only
# SSO_GROUP_CLAIM_NAME=
# INITIAL_ADMIN_EMAILS=
# PUBLIC_BASE_URL=
