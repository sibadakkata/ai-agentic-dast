# ============================================================
# Target Configuration
# Copy this file to targets.env and fill in your values
# DO NOT commit targets.env to version control
# ============================================================

# Target URL and credentials
T1_URL=https://your-target.example.com
T1_USERNAME=your-username@example.com
T1_PASSWORD=your-password

# Optional auth extras
# T1_TOTP_SECRET=JBSWY3DPEHPK3PXP
# T1_SSO_PROVIDER=okta
# T1_API_KEY=your-api-key
# T1_BEARER=your-bearer-token

# ============================================================
# LLM Provider Configuration
# ============================================================

# --- Option A: AWS Bedrock (recommended) ---
# On EC2: attach an IAM role with Bedrock permissions (no keys needed)
# Otherwise set credentials explicitly:
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=us-east-1
# Supported models:
#   bedrock/us.anthropic.claude-haiku-4-5-20251001-v1:0  (recommended)
#   bedrock/us.anthropic.claude-sonnet-4-6               (best quality)
#   bedrock/mistral.mistral-small-2402-v1:0              (cheapest)

# --- Option B: LiteLLM Proxy (optional, for teams with existing proxy) ---
# LITELLM_BASE_URL=https://litellm.your-company.com/
# LITELLM_API_KEY=sk-xxxx
